# Dashgithub review ports
DASHBURG_API_HOST=0.0.0.0
DASHBURG_API_PORT=8431
DASHBURG_RELOAD=0
DASHBURG_WEB_HOST=0.0.0.0
DASHBURG_WEB_PORT=4174
DASHBURG_WEB_MODE=preview
# DASHBURG_WEB_REBUILD_ON_START=1

# Runtime paths
DASHBURG_DATA_DIR=/home/youruser/apps/dashgithub/data
DASHBURG_CONFIG_DIR=/home/youruser/apps/dashgithub/data
DASHBURG_SECRETS_DIR=/home/youruser/apps/dashgithub/data
# Optional inventory override
# DASHBURG_REMOTEOPS_INVENTORY=/home/youruser/apps/dashgithub/data/remote_ops/servers.yaml

# Shared memory root for LocalOps/Memory/Orchestration
DASHBURG_SHARED_MEMORY_ROOT=/mnt/shared/dashgithub

# RemoteOps
REMOTEOPS_ADMIN_TOKEN=change-me
REMOTEOPS_SSH_USER=dashterm
REMOTEOPS_SSH_KEY_PATH=/home/youruser/.ssh/dashgithub_remoteops
REMOTEOPS_TERMINAL_ENTRY=/home/dashterm/dashterm-entry
# REMOTEOPS_TERMINAL_IDLE_TIMEOUT_SECONDS=1800

# LocalOps auth + providers
# LOCALOPS_ADMIN_TOKEN=change-me
OPENAI_API_KEY=sk-...
# OPENAI_API_BASE_URL=https://api.openai.com/v1
LOCALOPS_CHAT_UI_URL=http://127.0.0.1:3015

# Frontend -> API base
VITE_API_URL=http://127.0.0.1:8431
